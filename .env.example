# Opcional: solo para conectar la web a un proyecto propio de Supabase.
# Copia este archivo como .env y rellena. Sin estos valores la web usa los datos de ejemplo
# y el panel funciona en modo de ensayo, todo dentro del navegador.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_CLAVE=
# Opcional: dónde se sirven audios e imágenes (por defecto /medios, a través de la propia web).
PUBLIC_MEDIOS_URL=
