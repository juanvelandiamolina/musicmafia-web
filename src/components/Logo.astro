---
// Logo de MusicMafia: la nota cuyas cabezas son las de la pareja.
// Trazado del original (marca/logo-original.webp) con marching squares + simplificación,
// coincide en un 98,9 % con el dibujo; el color sale de currentColor para que funcione en claro y oscuro.
interface Props {
  class?: string;
  title?: string;
  /** Si es true, la nota baja y se posa sobre la pareja al cargar (solo en el inicio). */
  animado?: boolean;
}
const { class: clase, title = 'MusicMafia', animado = false } = Astro.props;
// title="" = decorativo (va junto al nombre escrito y no debe leerse dos veces).
const decorativo = title === '';
---
<svg
  class:list={['logo', clase, { 'logo--animado': animado }]}
  viewBox="646 340 584 1064"
  role={decorativo ? undefined : 'img'}
  aria-label={decorativo ? undefined : title}
  aria-hidden={decorativo ? 'true' : undefined}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <path class="logo__nota" fill="currentColor" d="M1191.4 342L1194.8 343L1195.1 351L1195 751L1194 758L1188 769L1179.7 778L1169 786.5L1142.8 801L1116 810L1091 813.5L1064.7 812L1042 806.4L1026 797.3L1013.7 783L1008 766L1007 754L1008.2 740L1013.9 724L1027.1 706L1044 691.7L1059 683.1L1081 675.8L1104 675.9L1129 681.1L1130.8 680L1130 451L899 478.7L897.9 481L897.8 555L897.8 791L896 802L890.4 815L883.5 824L873.2 833L853 843.8L830 850.7L801 854.7L781 854.4L769 852.5L743 843.8L726.4 833L714 818L708.9 806L706.7 795L707 775.4L713.9 755L723.9 742L739 730.8L755 723.8L780 718.4L805 718.6L831 723.7L834 722.1L834.9 411Z" />
  <path class="logo__pareja" fill="currentColor" d="M1039.6 856L1162 855.5L1178 858.3L1197 867.5L1208 877.4L1220.4 895L1226 909.9L1227.9 923L1227.9 1100L1224.2 1111L1216 1118.3L1210 1120.5L1204 1120.8L1194 1118.6L1185.8 1112L1181.9 1104L1181.4 943L1180.3 941L1178 940.6L1171 940.6L1169.3 943L1169.3 1372L1165.1 1387L1156.2 1397L1143 1402.2L1134 1402.3L1126 1400.5L1119 1397L1113 1391.7L1105.6 1378L1104.6 1368L1104.6 1126L1102.1 1123L1097 1123.4L1095.7 1126L1095.7 1365L1094.6 1379L1089.4 1390L1082 1397.1L1070 1402L1062 1402.3L1052 1400.4L1043.1 1395L1036.8 1387L1033.3 1378L1032 941.1L1028 940.6L1026 942.1L963.1 1095L955.8 1104L947.4 1108L938 1108.1L932 1106L925 1100.8L921.6 1096L862.6 944L852 942.9L849.8 944L860.6 982L921 1189L919 1191.3L856 1191.2L854 1192.4L853.9 1378L851.6 1389L845 1397.2L839 1400.5L832 1402L820 1400.4L810 1393.1L805.7 1384L804.3 1192L792 1191.1L789.9 1193L789.6 1382L786.1 1391L780.5 1397L774 1400.6L765 1402.2L754 1400.2L746.1 1395L740.9 1387L739 1378.3L738.5 1192L676 1191.3L674.1 1190L743.6 945L742 942.7L734 943L731.5 945L692 1082.8L688.1 1091L683 1097.1L677 1100.8L668 1102L657.6 1099L652 1093.8L648.2 1087L647.3 1081L648.1 1071L696.2 912L705 896.8L715.9 885L728 876.2L745 869L760 867.2L836 867.2L849 869L859 872.6L878 885.1L894 904L901.2 919L942 1021.7L990.6 900L998 884.3L1005 874.1L1016 863.8L1026 858.8Z" />
</svg>

<style>
  .logo {
    display: block;
    height: auto;
    overflow: visible;
  }

  /* Un único momento al cargar el inicio: la pareja aparece y la nota se posa sobre ella. */
  @media (prefers-reduced-motion: no-preference) {
    .logo--animado .logo__pareja {
      animation: mm-aparece 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .logo--animado .logo__nota {
      animation: mm-posa 1100ms cubic-bezier(0.16, 1, 0.3, 1) 450ms both;
    }
  }

  @keyframes mm-aparece {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes mm-posa {
    from { opacity: 0; transform: translateY(-90px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
