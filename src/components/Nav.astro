---
import Logo from './Logo.astro';
import Estrella from './Estrella.astro';

interface Props {
  seccion?: 'inicio' | 'productores' | 'otra';
}
const { seccion = 'otra' } = Astro.props;
const enlaces = [
  { href: '/', texto: 'inicio', clave: 'inicio' },
  { href: '/productores', texto: 'productores', clave: 'productores' },
];
---
<header class="nav">
  <nav class="nav__barra contenedor" aria-label="Principal">
    <a class="nav__marca" href="/">
      <Logo class="nav__logo" title="" />
      <span>musicmafia</span>
    </a>
    <ul class="nav__enlaces">
      {enlaces.map((e) => (
        <li>
          <a href={e.href} aria-current={seccion === e.clave ? 'page' : undefined}>
            {seccion === e.clave && <Estrella semilla={`nav-${e.clave}`} class="nav__estrella" />}
            {e.texto}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--fondo);
    border-bottom: 2px solid var(--negro);
  }

  .nav__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-alto);
  }

  .nav__marca {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--negro);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .nav__marca :global(.nav__logo) {
    width: auto;
    height: 32px;
  }

  .nav__enlaces {
    display: flex;
    gap: clamp(14px, 3vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__enlaces a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--negro);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav__enlaces a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .nav__enlaces :global(.nav__estrella) {
    width: 16px;
    height: 16px;
  }
</style>
