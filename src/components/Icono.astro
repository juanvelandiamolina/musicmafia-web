---
// Iconos de línea en una rejilla de 24 px, trazo 1,75. Siempre decorativos: el texto o aria-label va en el botón.
interface Props {
  nombre: 'tocar' | 'pausa' | 'atras10' | 'adelante10' | 'anterior' | 'siguiente' | 'instagram' | 'correo' | 'youtube' | 'spotify' | 'enlace' | 'listo';
  class?: string;
}
const { nombre, class: clase } = Astro.props;
---
<svg class:list={['icono', clase]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {nombre === 'tocar' && <path fill="currentColor" d="M7.5 4.9c0-.9 1-1.5 1.8-1l11 6.6c.7.4.7 1.5 0 2l-11 6.6c-.8.5-1.8-.1-1.8-1z" />}
  {nombre === 'pausa' && (
    <g fill="currentColor"><rect x="5.5" y="4" width="4.5" height="16" rx="1.4" /><rect x="14" y="4" width="4.5" height="16" rx="1.4" /></g>
  )}
  {nombre === 'anterior' && (
    <g fill="currentColor"><rect x="4.5" y="5" width="2.4" height="14" rx="1" /><path d="M19.5 6.2v11.6c0 .8-.9 1.3-1.6.8l-8.6-5.8a1 1 0 0 1 0-1.6l8.6-5.8c.7-.5 1.6 0 1.6.8z" /></g>
  )}
  {nombre === 'siguiente' && (
    <g fill="currentColor"><rect x="17.1" y="5" width="2.4" height="14" rx="1" /><path d="M4.5 6.2v11.6c0 .8.9 1.3 1.6.8l8.6-5.8a1 1 0 0 0 0-1.6L6.1 5.4c-.7-.5-1.6 0-1.6.8z" /></g>
  )}
  {nombre === 'atras10' && (
    <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.6 9.2A8 8 0 1 1 4 12" /><path d="M4.4 4.8v4.6H9" />
      <text x="12.4" y="15.6" fill="currentColor" stroke="none" font-size="7.6" font-weight="700" text-anchor="middle" font-family="inherit">10</text>
    </g>
  )}
  {nombre === 'adelante10' && (
    <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19.4 9.2A8 8 0 1 0 20 12" /><path d="M19.6 4.8v4.6H15" />
      <text x="11.6" y="15.6" fill="currentColor" stroke="none" font-size="7.6" font-weight="700" text-anchor="middle" font-family="inherit">10</text>
    </g>
  )}
  {nombre === 'instagram' && (
    <g fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" /></g>
  )}
  {nombre === 'correo' && (
    <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m3.8 7 8.2 6 8.2-6" /></g>
  )}
  {nombre === 'youtube' && (
    <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path fill="currentColor" stroke="none" d="M10 9.1v5.8l5.1-2.9z" /></g>
  )}
  {nombre === 'spotify' && (
    <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M7.2 9.7c3.2-1 6.8-.7 9.7.9" /><path d="M7.8 12.7c2.6-.8 5.5-.5 7.9.8" /><path d="M8.5 15.5c2-.6 4.2-.4 6.1.6" /></g>
  )}
  {nombre === 'enlace' && (
    <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /></g>
  )}
  {nombre === 'listo' && <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>

<style>
  .icono {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }
</style>
